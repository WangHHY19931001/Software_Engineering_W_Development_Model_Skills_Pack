# W-Model 运行时状态（项目状态 / RTM 数据）
.w-model/

# TLC 模型检查运行产物（states/<时间戳子目录>，不入库；第 35 轮修复后清理正则覆盖 2/4 位年份）
**/tla/specs/*/states/

# 运行时产物：门禁脚本输出的 gate-logs（check-bdd-model 等写入，历史遗留样本目录显式兜底）
**/samples/.w-model/gate-logs/

# 本地 Agent 工作目录（如 darwin-skill 评估产物，由外部工具维护，不纳入版本控制）
.claude/

# Cursor IDE 技能包/配置（第 43 轮起不再维护仓库内 .cursor 资产，防误跟踪）
.cursor/

# ZCode 客户端本地计划/会话产物
.zcode/

# IDE
.vscode/
.idea/
*.swp
*.swo

# 系统
.DS_Store
Thumbs.db

# 日志
*.log

# 环境变量
.env
.env.local
.env.*.local

# Node 依赖（package.json 声明 tsx / ajv / eslint-plugin-security / vitest 等开发依赖，依赖目录不入库）
node_modules/

# TypeScript 编译产物
dist/

# npm 安装产物
package-lock.json
npm-debug.log*
yarn-error.log*

# 测试与构建缓存
coverage/
*.tsbuildinfo
.eslintcache

# TypeDoc 生成物（npm run docs:build 产物，不入库；docs/ 下只维护手写设计文档）
docs/api/

# Git worktrees（本地隔离工作区，不入库）
.worktrees/
