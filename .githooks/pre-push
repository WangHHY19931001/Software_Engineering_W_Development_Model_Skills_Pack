#!/usr/bin/env bash
# 本地推送前门禁（pre-push gate）
#
# 目的：替代远程 CI，在 `git push` 前自动跑校验脚本回归基线，防止
#       w-model-dev/scripts/*.ts 与 samples/ 漂移。任何一项失败即中止 push。
#
# 启用方式（postinstall 已自动启用；手动重置执行 npm run setup:hooks）：
#   npm run setup:hooks        # 等价于 git config core.hooksPath .githooks
#
# 临时跳过（仅紧急情况，勿用于常规开发）：
#   git push --no-verify
#
# 触发条件：仅当本次推送范围内含以下路径的变更时才跑门禁，其余（纯目录等非内容变更）放行。
#   - w-model-dev/**：case 模式 w-model-dev/*（bash case 模式中 * 可跨 /，命中任意层级文件）
#   - 根级活体文档/配置：README.md / AGENTS.md / CONTRIBUTING.md / .gitignore / .eslintsecurity-baseline.json / package.json / package-lock.json
#   - config/** / scripts/** / .githooks/**（同上，* 跨 /）
#   - eval/**：评估资产（语料 / mappings / runner）——触发边界断言是活体门禁（第 18 项）
#   - docs/*.md（* 跨 /：实际命中 docs/ 任意层级 *.md，含 docs/changes、docs/superpowers
#     归档——保持历史触发语义，不做收窄）

set -euo pipefail

# ---------- 命令行参数 ----------
# --force：强制跑全部门禁（等价于历史环境变量 PREPUSH_FORCE=1，跨平台写法）。
# 手动验证：bash .githooks/pre-push --force  或  npm run prepush
FORCE=0
if [ "${1:-}" = "--force" ]; then
  FORCE=1
fi

# git push 调用 hook 时第一个参数是 remote 名（$2 为 URL）——新分支 remote-tracking
# 排除集枚举（下方 A6 降级路径）要用它核验远端；--force / 手动执行时为 --force 或空。
PUSH_REMOTE="${1:-}"

# ---------- Windows 兼容入口 ----------
# pre-push 依赖 bash（package.json prepush 用 `bash .githooks/pre-push`）。
# Git Bash / MSYS / MINGW / CYGWIN 环境自带 bash，可正常执行本脚本，**必须跑门禁**；
# 仅原生 cmd/PowerShell（无 bash 解释器，无法执行本脚本）时给出指引并放行（exit 0），
# 避免误报失败。Linux/macOS 不受影响。本脚本 grep 正则仅用 POSIX ERE，无 GNU `\b` 等专有语法。
is_pure_windows_shell() {
  # Git Bash / MSYS / MINGW 环境：可运行 bash，不视为纯 Windows
  if [ -n "${MSYSTEM:-}" ]; then
    return 1
  fi
  case "${OSTYPE:-}" in
    msys*|cygwin*|mingw*) return 1 ;;
    linux*|darwin*|freebsd*|openbsd*|solaris*|aix*) return 1 ;;
  esac
  if [ -z "${OSTYPE:-}" ]; then
    # OSTYPE 未设置时用 uname 兜底判定
    local uname_s
    uname_s="$(uname -s 2>/dev/null || true)"
    case "$uname_s" in
      MSYS*|MINGW*|CYGWIN*) return 1 ;;   # Git Bash：可运行
      Linux|Darwin|FreeBSD|OpenBSD) return 1 ;;
    esac
  fi
  return 0
}

if is_pure_windows_shell; then
  printf '[pre-push] \033[31m✗\033[0m 检测到纯 Windows cmd/PowerShell 环境（无 bash 解释器）\n' 2>/dev/null || true
  printf '[pre-push] \033[31m✗\033[0m 本次推送未执行 18 项门禁（exit 0 放行）——推送未经任何校验\n' 2>/dev/null || true
  printf '[pre-push] \033[31m✗\033[0m 关键门禁：self-test / vitest 全量 / docs-consistency / tsc 类型检查 等 18 项\n' 2>/dev/null || true
  printf '[pre-push] \033[31m✗\033[0m 请安装 Git for Windows 并在 Git Bash 补跑：npm run prepush（全绿后再合入）\n' 2>/dev/null || true
  exit 0
fi

# ---------- 工具函数 ----------
# 说明：Git for Windows 下 hook 的 stdout fd 可能无效（Bad file descriptor），
# 所有输出统一容错（2>/dev/null || true），避免 set -e 下 printf 写失败中断 hook。

log()  { printf '[pre-push] %s\n' "$*" 2>/dev/null || true; }
ok()   { printf '[pre-push] \033[32m✓\033[0m %s\n' "$*" 2>/dev/null || true; }
fail() { printf '[pre-push] \033[31m✗\033[0m %s\n' "$*" 2>/dev/null || true; }
warn() { printf '[pre-push] \033[33m⚠\033[0m %s\n' "$*" 2>/dev/null || true; }

# ---------- 路径过滤：无相关变更直接放行 ----------
#
# --force（或历史环境变量 PREPUSH_FORCE=1）时强制跑全部门禁，便于手动验证
# （npm run prepush 默认 --force）。实际 git push 触发时不带，仍按变更路径过滤。
# FORCE 分支在读取 stdin 之前即结束（bash 只在显式读取时才触碰 stdin，不消费不阻塞），
# --force 不改变下方 stdin ref 解析 / 删除处理 / fallback / fail-closed 任何语义。

if [ "$FORCE" != "1" ] && [ "${PREPUSH_FORCE:-0}" != "1" ]; then
  # =====================================================================
  # pre-push hook stdin ref 解析：git 推送时 stdin 必有 ≥1 行，因此**先读 stdin**
  # 再做范围判断，不再用全局 diff（HEAD@{push}/origin/HEAD）先行短路——全局 diff 非空但
  # 不相关时旧实现会跳过 stdin，多 ref 推送漏检。每行严格四字段（IFS 空白分隔，
  # 行内多余空白容忍）：
  #   <local ref> <local sha> <remote ref> <remote sha>
  #   - ref 非空；sha 必须 40 位十六进制（全零 sha 合法：第 2 字段全零 = 删除远端 ref，
  #     第 4 字段全零 = 全新分支）
  #   - 任一解析失败 → fail-closed：无法证明变更范围就不缩小范围，直接运行全部门禁
  # 有 stdin 行时以 stdin 为准（逐行聚合变更文件）。
  # =====================================================================

  ZERO_SHA="0000000000000000000000000000000000000000"

  # 路径匹配（共享）：$1 为换行分隔的变更文件列表。命中任一前缀 → 返回 0（需跑门禁，
  # grep 式语义），否则返回 1。
  # 注意：bash case 的模式匹配与文件通配不同，* 可跨 /，因此 w-model-dev/* 命中任意层级
  # 文件、docs/*.md 命中 docs/ 任意层级 *.md——历史触发语义如此，不做收窄。
  files_need_gate() {
    local files="$1"
    local f
    while IFS= read -r f; do
      [ -z "$f" ] && continue
      case "$f" in
        w-model-dev/*)                          return 0 ;;
        README.md|AGENTS.md|CONTRIBUTING.md|.gitignore|.eslintsecurity-baseline.json|package.json|package-lock.json) return 0 ;;
        config/*|scripts/*|.githooks/*)         return 0 ;;
        eval/*)                                 return 0 ;;
        docs/*.md)                              return 0 ;;
      esac
    done <<EOF
$files
EOF
    return 1
  }

  # 新分支 remote-tracking 排除集枚举（merge-base 无法证明 / 退化到推送尖本身时的
  # 降级尝试）：`git -c core.quotePath=false log -m --name-only <local_sha> --not
  # --remotes=<remote>` 枚举本次
  # 推送真正新增提交（远端已跟踪 refs 覆盖之外）涉及的变更文件。
  # -m 必须保留：merge commit 默认只显示空 diff，merge 冲突解决中引入的文件会从排除集
  # 静默消失（其余路径全无关时门禁被跳过）；-m 对 merge 的每个父输出文件清单，宁可多列
  # 远端已知内容触发门禁（过包含方向安全，偶发成本与既有 fail-closed 全门禁同级）。
  # 安全边界（任一不满足 → 返回非 0，调用方 fail-closed 跑全部门禁，绝不缩小范围）：
  #   1. remote 名必须来自 hook 第一个参数且经白名单核验（仅字母数字 . _ -，且不得以
  #      - 开头——前导 - 会被 git 子命令解析为选项，防选项注入面；防注入：拒绝空白/换行/引号等）
  #   2. `git remote get-url` 核验 remote 确实配置
  #   3. remote 须存在 ≥1 个 remote-tracking ref（无排除集 = 无证据，不得空放行）
  #   4. 枚举命令本身失败同样 fail-closed
  remote_enum_new_branch_files() {
    local local_sha="$1"
    local remote_name="${2:-}"
    local tracking out
    case "$remote_name" in
      ''|-*|*[!A-Za-z0-9._-]*)
        return 1 ;;   # remote 名非法/缺失/前导 -（防注入；前导 - 防选项注入面）
    esac
    if ! git remote get-url "$remote_name" >/dev/null 2>&1; then
      return 1        # remote 未配置
    fi
    if ! tracking="$(git for-each-ref "refs/remotes/$remote_name" 2>/dev/null)"; then
      return 1        # for-each-ref 失败
    fi
    [ -n "$tracking" ] || return 1   # 无任何 remote-tracking ref
    if ! out="$(git -c core.quotePath=false log -m --name-only --pretty=format: "$local_sha" --not "--remotes=$remote_name" 2>/dev/null)"; then
      return 1        # 排除集枚举失败
    fi
    printf '%s\n' "$out"
    return 0
  }

  # 终端（交互手动执行）不读取 stdin，避免阻塞在交互输入；管道/重定向（git push、
  # CI、文件重定向）正常读取（git 写完 ref 行即关闭管道 → EOF）。
  stdin_saw_line=0
  parse_failed=0
  parse_reason=""
  delete_only=1
  changed_files=""
  if [ ! -t 0 ]; then
    # ===== git push 场景：单次遍历 stdin，逐行严格校验并聚合变更文件 =====
    while IFS= read -r stdin_line || [ -n "$stdin_line" ]; do
      stdin_saw_line=1
      if [ -z "$stdin_line" ]; then
        parse_failed=1
        parse_reason="ref 行为空"
        break
      fi
      local_ref="" local_sha="" remote_ref="" remote_sha="" extra=""
      IFS=' ' read -r local_ref local_sha remote_ref remote_sha extra <<< "$stdin_line"
      if [ -z "$local_ref" ] || [ -z "$local_sha" ] || [ -z "$remote_ref" ] || [ -z "$remote_sha" ] || [ -n "$extra" ]; then
        parse_failed=1
        parse_reason="ref 行字段不齐（应为 <local ref> <local sha> <remote ref> <remote sha> 四字段）：${stdin_line}"
        break
      fi
      if ! [[ "$local_sha" =~ ^[0-9a-fA-F]{40}$ ]] || ! [[ "$remote_sha" =~ ^[0-9a-fA-F]{40}$ ]]; then
        parse_failed=1
        parse_reason="sha 非 40 位十六进制：${stdin_line}"
        break
      fi

      if [ "$local_sha" = "$ZERO_SHA" ]; then
        # 删除远端 ref：本地无内容可检，跳过该行的文件收集，继续处理其他行
        log "远端 ref 删除 ${local_ref}：本地无内容可检，跳过该行"
        continue
      fi
      delete_only=0
      line_diff=""
      if [ "$remote_sha" = "$ZERO_SHA" ]; then
        # 全新分支（远端对象不存在）：先尝试建立可证明基线（--fork-point 优先，
        # 退化为普通 merge-base）。绝不使用 `git log -n N` 截断（>N 提交的新分支会漏检）。
        # 注意退化情形：同名本地 ref 会让 merge-base 解到推送尖本身（base == local_sha，
        # 实测 fork-point 对自身 reflog 亦如此）——那不是可证明的祖先基线。
        # 退化/无法证明时降级尝试远端 remote-tracking 排除集枚举（remote_enum_new_branch_files，
        # 用 hook $1 的 remote 核验）；排除集亦不可证明 → fail-closed 全量门禁（不改 fail-closed 方向，
        # 只降常见路径成本：基于已 fetch 远端状态的新分支首推可用 tracking refs 证明范围）。
        base=""
        base="$(git merge-base --fork-point "$remote_ref" "$local_sha" 2>/dev/null)" || true
        if [ -z "$base" ]; then
          base="$(git merge-base "$remote_ref" "$local_sha" 2>/dev/null)" || true
        fi
        if [ -z "$base" ] || [ "$base" = "$local_sha" ]; then
          if ! line_diff="$(remote_enum_new_branch_files "$local_sha" "$PUSH_REMOTE")"; then
            parse_failed=1
            parse_reason="新分支 ${local_ref} 无法建立可证明基线（merge-base 为空/退化到推送尖端本身，remote-tracking 排除集亦不可用：remote 名非法/未配置/无 tracking refs/枚举失败）；fail-closed 运行全部门禁"
            break
          fi
          log "新分支 ${local_ref}：merge-base 不可证明，经 remote-tracking 排除集（--not --remotes=${PUSH_REMOTE}）枚举本次推送新增变更"
        else
          if ! line_diff="$(git -c core.quotePath=false diff --name-only "$base" "$local_sha" -- 2>/dev/null)"; then
            parse_failed=1
            parse_reason="git diff 失败（${local_ref} ${base}..${local_sha}）"
            break
          fi
        fi
      else
        # 常规更新：远端对象本地可达。`--` 必须置于两 sha 之后——git diff 在 `--`
        # 之后只解析 pathspec，把 `--` 前移会把 sha 当路径致空输出（静默漏检）。
        if ! line_diff="$(git -c core.quotePath=false diff --name-only "$remote_sha" "$local_sha" -- 2>/dev/null)"; then
          parse_failed=1
          parse_reason="git diff 失败（${local_ref} ${remote_sha}..${local_sha}）"
          break
        fi
      fi
      if [ -n "$line_diff" ]; then
        changed_files="${changed_files}${line_diff}"$'\n'
      fi
    done
  fi

  if [ "$stdin_saw_line" -eq 1 ]; then
    if [ "$parse_failed" -eq 1 ]; then
      fail "pre-push stdin ref 解析失败：${parse_reason}（fail-closed：无法证明变更范围，运行全部门禁）"
    elif [ "$delete_only" -eq 1 ]; then
      # 全部行均为删除（delete-only push）：无本地提交内容，说明后放行
      ok "本次推送仅删除远端 ref（本地无提交内容可检），跳过门禁"
      exit 0
    elif files_need_gate "$changed_files"; then
      : # 命中门禁相关路径 → fall through 到下方门禁
    else
      ok "本次推送未触及门禁相关文件（scripts/ 文档 / schema / 配置），跳过门禁"
      exit 0
    fi
  else
    # ===== stdin 为空：非 git push 触发（手动执行 / EOF 重定向 / 终端交互）=====
    # 保留历史兜底语义：HEAD@{push} 相对 HEAD 的变更；HEAD@{push} 不可用时回退
    # origin/HEAD。注意这只是「当前分支相对上游」的近似——git 实际推送必有 stdin，
    # 多 ref / 新分支 / 删除场景全部由上方 stdin 路径处理。
    log "stdin 无 ref 行（非 git push 触发），回退 HEAD@{push}/origin/HEAD 范围判断"
    if changed_files="$(git -c core.quotePath=false diff --name-only HEAD@{push} HEAD 2>/dev/null || git -c core.quotePath=false diff --name-only origin/HEAD HEAD 2>/dev/null)"; then
      if [ -n "$changed_files" ]; then
        if files_need_gate "$changed_files"; then
          : # 命中门禁相关路径 → fall through 到下方门禁
        else
          ok "本次推送未触及门禁相关文件（scripts/ 文档 / schema / 配置），跳过门禁"
          exit 0
        fi
      else
        # diff 成功但无输出 = 可证明相对上游无任何变更（手动执行、仓库已同步），放行
        ok "回退范围判断无待推送变更（相对上游无差异），跳过门禁"
        exit 0
      fi
    else
      fail "回退范围判断失败（HEAD@{push} 与 origin/HEAD 均不可用）：无法证明无相关变更（fail-closed），运行全部门禁"
    fi
  fi
fi

log "检测到校验脚本相关变更，启动推送前门禁..."

# ---------- 依赖检查 ----------

if ! command -v npm >/dev/null 2>&1; then
  fail "未找到 npm，请先安装 Node.js >= 20"
  exit 1
fi

if [ ! -d node_modules ]; then
  fail "node_modules 缺失，请先运行 npm install"
  exit 1
fi

# ---------- 平台依赖检查（只读） ----------
log "平台依赖检查（ensure-platform-deps --check）..."
if ! bash "$(dirname "$0")/ensure-platform-deps.sh" --check; then
  fail "平台依赖检查失败，中止推送"
  exit 1
fi

# ---------- 门禁用例 ----------
# 全部门禁共 18 项检查（第 13 项 npm audit 为阻断项），退出码必须全部符合预期才放行。

tmp_log="$(mktemp)"
tmp_vitest_dir="$(mktemp -d)"
tmp_vitest_json="$tmp_vitest_dir/results.json"
tmp_vitest_provenance="$tmp_vitest_dir/provenance.json"
trap 'rm -f "$tmp_log"; rm -rf "$tmp_vitest_dir"' EXIT

# run_expect <描述> <期望退出码> <命令...>
run_expect() {
  local desc="$1"; shift
  local expect="$1"; shift
  set +e
  "$@" >"$tmp_log" 2>&1
  local code=$?
  set -e
  if [ "$code" -ne "$expect" ]; then
    fail "$desc（期望 exit $expect，实际 $code）"
    cat "$tmp_log"
    return 1
  fi
  ok "$desc（exit $code）"
  return 0
}

# 1. self-test：262 条样本回归基线（覆盖全部 check-*.ts 的通过 / 失败 / 输入错误三态，分类明细见 self-test.ts 输出），必须 exit 0
run_expect "self-test 全部样本匹配期望" 0 npm run self-test || exit 1

# 2. check:verifier 无参数应退出 2（输入错误）
run_expect "check:verifier 无参数退出 2" 2 npm run check:verifier || exit 1

# 3. check:gate 不存在的目录应退出 2（输入错误）
run_expect "check:gate 不存在目录退出 2" 2 npm run check:gate -- /tmp/nonexistent || exit 1

# 4. check:verifier 对有效样本应退出 0
run_expect "check:verifier 有效样本退出 0" 0 \
  npm run check:verifier -- w-model-dev/scripts/samples/verifier/valid.json || exit 1

# 5. check:verifier 对无效样本应退出 1（校验失败）
run_expect "check:verifier 无效样本退出 1" 1 \
  npm run check:verifier -- w-model-dev/scripts/samples/verifier/bad-ranking-k.json || exit 1

# 6. security-scan：跑 eslint-plugin-security + baseline 比对，必须 exit 0
run_expect "security-scan 无新增风险" 0 \
  npx tsx w-model-dev/scripts/cli/security-scan.ts || exit 1

# 7. check-bdd-model 对有效 BDD 样本应退出 0（技能包 fixture 回归；不直接运行 TLA、TLA↔BDD 同步或项目工件阶段门，不启用 require flags，因此不要求 named/passed Cucumber 证据）
run_expect "check-bdd-model 有效 BDD 样本退出 0" 0 \
  npx tsx w-model-dev/scripts/cli/check-bdd-model.ts w-model-dev/scripts/samples/bdd/valid-manifest.json --phase=1 || exit 1

# 8. check-bdd-model 对 schema 不合规 BDD 样本应退出 2（输入错误）
run_expect "check-bdd-model schema 不合规 BDD 样本退出 2" 2 \
  npx tsx w-model-dev/scripts/cli/check-bdd-model.ts w-model-dev/scripts/samples/bdd/bad-schema.manifest.json --phase=1 || exit 1

# 9. check:coverage 对有效覆盖样本应退出 0（阶段 1 需求覆盖分析门禁 C1-C10）
run_expect "check:coverage 有效覆盖样本退出 0" 0 \
  npm run check:coverage -- w-model-dev/scripts/samples/coverage/valid-minimal-coverage.json || exit 1

# 10. check:exemption 对有效豁免样本应退出 0（豁免审批门禁 E1-E9，S→R→V→人类四阶段）
run_expect "check:exemption 有效豁免样本退出 0" 0 \
  npm run check:exemption -- w-model-dev/scripts/samples/exemption/valid-full-approval.json || exit 1

# 11. check-signature-chain 对有效签名链样本应退出 0
run_expect "check-signature-chain 有效签名链样本退出 0" 0 \
  npx tsx w-model-dev/scripts/cli/check-signature-chain.ts w-model-dev/scripts/samples/signature-chain/valid-all-roles.jsonl --phase=1 || exit 1

# 12. vitest 单元测试全量通过（文件数/用例数以同次 JSON facts 与 provenance 为准）+ coverage 阈值门禁（--coverage 启用 v8 插桩；
#     logic/ + lib/ 阈值 stmts 75 / branch 65 / funcs 85 / lines 75，阈值不达标 vitest 会 exit 1 阻断推送；
#     基线见 config/vitest.config.ts coverage.thresholds 注释）
#     --reporter=json --outputFile 落盘实测用例总数，供第 14 项 check-docs-consistency 复用（避免 vitest 双跑）
run_expect "vitest 单元测试 + coverage 阈值通过" 0 \
  npx vitest run --coverage --reporter=json --outputFile="$tmp_vitest_json" --config config/vitest.config.ts || exit 1

# 将第 12 项同次 JSON 封装为受控 provenance，绑定当前 HEAD、运行 ID、相对 artifact 与完整 measurements。
node -e 'const fs=require("fs"),crypto=require("crypto"),cp=require("child_process"),path=require("path"); const artifact=process.argv[1], provenance=process.argv[2], root=process.cwd(); const raw=fs.readFileSync(artifact,"utf8"), d=JSON.parse(raw), sha=crypto.createHash("sha256").update(raw,"utf8").digest("hex"), head=cp.execFileSync("git",["rev-parse","HEAD"],{cwd:root,encoding:"utf8"}).trim(), runId=crypto.randomBytes(8).toString("hex"); fs.writeFileSync(provenance, JSON.stringify({format:"w-model-vitest-provenance",version:1,commitSha:head,runId,artifactRelativePath:path.basename(artifact),artifactSha256:sha,measurements:d},null,2)+"\n");' "$tmp_vitest_json" "$tmp_vitest_provenance"

# 13. npm audit：依赖漏洞扫描（high 以上阻断；仅明确网络不可达或 registry 不支持 endpoint 时跳过）
#     skip 只接受 npm 明确前缀的网络错误、明确错误码，或明确 audit endpoint unsupported 信号；
#     瞬态网络错误信号扩展（registry 服务端瞬态：socket hang up / 5xx / errno 形态网络错误码）
#     同样可跳过；npm7 形态 `npm warn audit network ...` 亦属网络信号（network 词面前允许
#     audit 前缀）。E404 仅在 registry/advisories 上下文（`404 Not Found - GET …registry|
#     advisories`）跳过，裸 `code E404` 保持阻断；状态词（Bad Gateway 等）须同行含
#     network/registry/request 锚定，裸状态词保持阻断。任意漏洞报告、JSON 解析、权限/配置
#     错误都 fail-closed，不因文本中出现 network 而放行。
audit_has_blocking_signal() {
  grep -qiE \
    '(^|[[:space:]])(npm (error|warn|err!)[[:space:]]+)?(code[[:space:]]+(EACCES|EPERM|EJSONPARSE|ECONFIG)|.*(vulnerab[a-z]*|permission denied|JSON (parse|input|error)|config(uration)? (error|invalid|failed)))' \
    "$tmp_log"
}

audit_can_skip() {
  if audit_has_blocking_signal; then
    return 1
  fi
  # 判定锚定在 npm 自身的 error/warn/err! 前缀行；词面 network 只识别前缀紧邻处或
  # `npm warn audit network`（npm7 形态，防 network-text/networking 等无关文本放宽）。
  # 可确证的网络层信号允许出现在该行任意位置：网络错误码（code/errno 形态，含 HTTP
  # 5xx/429 码）、socket hang up、'reason: getaddrinfo/connect <E码>'、5xx/429 响应文本、
  # registry/advisories 上下文中的 404（裸 E404 不跳），以及带 network/registry/request
  # 同行锚定的状态词（裸状态词不跳，防 HTML 错误页正文误放行）。
  grep -qiE \
    '^npm (error|warn|err!)[[:space:]]+((code|errno)[[:space:]]+(ENOTFOUND|ETIMEDOUT|ECONNREFUSED|EAI_AGAIN|ENETUNREACH|EHOSTUNREACH|ECONNRESET|ENOTSUP|ENOAUDIT|E429|E5[0-9]{2})|404[[:space:]]+Not[[:space:]]+Found[[:space:]]+-[[:space:]]+GET[[:space:]]+[^[:space:]]*(registry|advisories)|(audit[[:space:]]+)?network([[:space:]:]|$)|problem related to network connectivity|NOT_IMPLEMENTED|registry[[:space:]]+[^[:space:]]+[[:space:]]+does not support audit endpoint|does not support audit endpoint|.*(socket hang up|reason: (getaddrinfo|connect)[[:space:]]+E[A-Z0-9]+|(429|5[0-9]{2})([[:space:]]+|-)(Bad Gateway|Service Unavailable|Gateway Time-?out|Internal Server Error|Too Many Requests)|((network|registry|request).*[^[:alnum:]_](Bad Gateway|Service Unavailable|Gateway Time-?out|Internal Server Error)([^[:alnum:]_]|$)|(.*[^[:alnum:]_])?(Bad Gateway|Service Unavailable|Gateway Time-?out|Internal Server Error)([^[:alnum:]_]|$).*(network|registry|request))))' \
    "$tmp_log"
}
log "npm audit 依赖漏洞扫描（high 以上阻断）..."
set +e
npm audit --audit-level=high >"$tmp_log" 2>&1
local_audit_code=$?
set -e
if [ "$local_audit_code" -eq 0 ]; then
  ok "npm audit 未发现 high 以上漏洞"
elif { [ "$local_audit_code" -eq 255 ] || [ "$local_audit_code" -eq 1 ]; } && audit_can_skip; then
  warn "npm audit 网络不可达或 registry 不支持 audit endpoint，跳过（不阻断）"
  cat "$tmp_log" >&2
else
  fail "npm audit 发现 high 以上漏洞或执行失败（返回码 $local_audit_code）"
  cat "$tmp_log" >&2
  exit 1
fi

# 14. check-docs-consistency：活体文档一致性门禁（复用第 12 项 vitest JSON 用例数，不二次全量 vitest）
#     注意 1：run_expect 以 "$@" 展开命令，`VAR=x npm ...` 前缀语法不被识别为 env 赋值，须先 export；
#     注意 2：Git Bash 的 mktemp 产出 MSYS 路径（/tmp/…），Node（Windows）无法直接解析——用 cygpath -w
#     翻译成 Windows 路径；WSL / 无 cygpath 时保留原值（Node 在 POSIX 下能正确 resolve /tmp/…）。
export WM_VITEST_COUNT_FILE="$(cygpath -w "$tmp_vitest_json" 2>/dev/null || printf '%s' "$tmp_vitest_json")"
export WM_VITEST_PROVENANCE_FILE="$(cygpath -w "$tmp_vitest_provenance" 2>/dev/null || printf '%s' "$tmp_vitest_provenance")"
export WM_VITEST_PROVENANCE_ROOT="$(cygpath -w "$tmp_vitest_dir" 2>/dev/null || printf '%s' "$tmp_vitest_dir")"
run_expect "docs-consistency 活体文档一致" 0 npm run check:docs-consistency || exit 1

