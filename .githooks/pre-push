#!/usr/bin/env bash
# 本地推送前门禁（pre-push gate）
#
# 目的：替代远程 CI，在 `git push` 前自动跑校验脚本回归基线，防止
#       w-model-dev/scripts/*.ts 与 samples/ 漂移。任何一项失败即中止 push。
#
# 启用方式（仓库克隆后执行一次）：
#   npm run setup:hooks        # 等价于 git config core.hooksPath .githooks
#
# 临时跳过（仅紧急情况，勿用于常规开发）：
#   git push --no-verify
#
# 触发条件：仅当本次推送的提交里包含以下路径的变更时才跑门禁，
#           纯配置/纯目录（docs/superpowers、docs/changes）改动直接放行：
#   - w-model-dev/**
#   - 根级活体文档/配置：README.md / AGENTS.md / CONTRIBUTING.md / .gitignore / .eslintsecurity-baseline.json / package.json
#   - .githooks/**
#   - docs/*.md（docs/ 根级 .md，子目录归档不触发）
#   - .cursor/skills/**

set -euo pipefail

# ---------- 命令行参数 ----------
# --force：强制跑全部门禁（等价于历史环境变量 PREPUSH_FORCE=1，跨平台写法）。
# 手动验证：bash .githooks/pre-push --force  或  npm run prepush
FORCE=0
if [ "${1:-}" = "--force" ]; then
  FORCE=1
fi

# ---------- Windows 兼容入口 ----------
# pre-push 依赖 bash（package.json prepush 用 `bash .githooks/pre-push`）。
# Git Bash / MSYS / MINGW / CYGWIN 环境自带 bash，可正常执行本脚本，**必须跑门禁**；
# 仅原生 cmd/PowerShell（无 bash 解释器，无法执行本脚本）时给出指引并放行（exit 0），
# 避免误报失败。Linux/macOS 不受影响。
is_pure_windows_shell() {
  # Git Bash / MSYS / MINGW 环境：可运行 bash，不视为纯 Windows
  if [ -n "${MSYSTEM:-}" ]; then
    return 1
  fi
  case "${OSTYPE:-}" in
    msys*|cygwin*|mingw*) return 1 ;;
    linux*|darwin*|freebsd*|openbsd*|solaris*|aix*) return 1 ;;
  esac
  if [ -z "${OSTYPE:-}" ]; then
    # OSTYPE 未设置时用 uname 兜底判定
    local uname_s
    uname_s="$(uname -s 2>/dev/null || true)"
    case "$uname_s" in
      MSYS*|MINGW*|CYGWIN*) return 1 ;;   # Git Bash：可运行
      Linux|Darwin|FreeBSD|OpenBSD) return 1 ;;
    esac
  fi
  return 0
}

if is_pure_windows_shell; then
  printf '[pre-push] \033[33m⚠\033[0m 检测到纯 Windows cmd/PowerShell 环境（无 bash 解释器）\n'
  printf '[pre-push] \033[33m⚠\033[0m 请安装 Git for Windows 并使用 Git Bash 运行：npm run prepush\n'
  printf '[pre-push] \033[33m⚠\033[0m 本次推送门禁已跳过（exit 0）\n'
  exit 0
fi

# ---------- 工具函数 ----------

log()  { printf '[pre-push] %s\n' "$*"; }
ok()   { printf '[pre-push] \033[32m✓\033[0m %s\n' "$*"; }
fail() { printf '[pre-push] \033[31m✗\033[0m %s\n' "$*"; }
warn() { printf '[pre-push] \033[33m⚠\033[0m %s\n' "$*"; }

# ---------- 路径过滤：无相关变更直接放行 ----------
#
# --force（或历史环境变量 PREPUSH_FORCE=1）时强制跑全部门禁，便于手动验证
# （npm run prepush 默认 --force）。实际 git push 触发时不带，仍按变更路径过滤。

if [ "$FORCE" != "1" ] && [ "${PREPUSH_FORCE:-0}" != "1" ]; then
  # pre-push hook stdin 格式：<local ref> <local sha> <remote ref> <remote sha>
  # 读取所有待推送的 ref 行，聚合后判断变更范围。
  changed_files="$(git diff --name-only HEAD@{push} HEAD 2>/dev/null || git diff --name-only origin/HEAD HEAD 2>/dev/null)"

  # 兜底：上面的 diff 失败（首次推送、无 upstream 等），改为扫描本次待推送的提交列表
  if [ -z "$changed_files" ]; then
    while read -r local_ref local_sha remote_ref remote_sha; do
      # 全新的远程分支（remote_sha 全 0）→ 取本地最近 20 条提交里的变更
      if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        changed_files="${changed_files}$(git log --name-only --pretty=format: -n 20 "$local_sha" 2>/dev/null)"
      else
        changed_files="${changed_files}$(git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null)"
      fi
    done
  fi

  # 命中任一前缀即需要跑门禁
  needs_gate=0
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    case "$f" in
      w-model-dev/*)                             needs_gate=1; break ;;
      README.md|AGENTS.md|CONTRIBUTING.md|.gitignore|.eslintsecurity-baseline.json|package.json) needs_gate=1; break ;;
      .githooks/*)                               needs_gate=1; break ;;
      docs/*.md)                                 needs_gate=1; break ;;
      .cursor/skills/*)                          needs_gate=1; break ;;
    esac
  done <<EOF
$changed_files
EOF

  if [ "$needs_gate" -eq 0 ]; then
    ok "本次推送未触及门禁相关文件（scripts/ 文档 / schema / 配置），跳过门禁"
    exit 0
  fi
fi

log "检测到校验脚本相关变更，启动推送前门禁..."

# ---------- 依赖检查 ----------

if ! command -v npm >/dev/null 2>&1; then
  fail "未找到 npm，请先安装 Node.js >= 20"
  exit 1
fi

if [ ! -d node_modules ]; then
  log "node_modules 缺失，先执行 npm install --no-audit --no-fund"
  npm install --no-audit --no-fund >/dev/null 2>&1 || {
    fail "npm install 失败"
    exit 1
  }
fi

# ---------- 平台依赖自动补装（WSL / Windows 双平台共存） ----------
# node_modules 在 Windows 侧安装时仅含 win32 原生二进制（esbuild / rolldown）；
# 在 WSL/Linux 侧运行门禁前自动补装对应平台二进制（npm pack + 解压，绕过 npm
# 依赖树，避免单侧 npm install 删除另一平台包）。仅提示 + 失败即中止。
log "平台依赖检查（ensure-platform-deps）..."
if ! bash "$(dirname "$0")/ensure-platform-deps.sh"; then
  fail "平台依赖补装失败，中止推送"
  exit 1
fi

# ---------- 门禁用例 ----------
# 与原 CI 一致：14 项检查（第 13 项 npm audit 为 warn-only），退出码必须全部符合预期才放行。

tmp_log="$(mktemp)"
trap 'rm -f "$tmp_log"' EXIT

# run_expect <描述> <期望退出码> <命令...>
run_expect() {
  local desc="$1"; shift
  local expect="$1"; shift
  set +e
  "$@" >"$tmp_log" 2>&1
  local code=$?
  set -e
  if [ "$code" -ne "$expect" ]; then
    fail "$desc（期望 exit $expect，实际 $code）"
    cat "$tmp_log"
    return 1
  fi
  ok "$desc（exit $code）"
  return 0
}

# 1. self-test：249 条样本回归基线（覆盖全部 check-*.ts 的通过 / 失败 / 输入错误三态，分类明细见 self-test.ts 输出），必须 exit 0
run_expect "self-test 全部样本匹配期望" 0 npm run self-test || exit 1

# 2. check:verifier 无参数应退出 2（输入错误）
run_expect "check:verifier 无参数退出 2" 2 npm run check:verifier || exit 1

# 3. check:gate 不存在的目录应退出 2（输入错误）
run_expect "check:gate 不存在目录退出 2" 2 npm run check:gate -- /tmp/nonexistent || exit 1

# 4. check:verifier 对有效样本应退出 0
run_expect "check:verifier 有效样本退出 0" 0 \
  npm run check:verifier -- w-model-dev/scripts/samples/verifier/valid.json || exit 1

# 5. check:verifier 对无效样本应退出 1（校验失败）
run_expect "check:verifier 无效样本退出 1" 1 \
  npm run check:verifier -- w-model-dev/scripts/samples/verifier/bad-ranking-k.json || exit 1

# 6. security-scan：跑 eslint-plugin-security + baseline 比对，必须 exit 0
run_expect "security-scan 无新增风险" 0 \
  npx tsx w-model-dev/scripts/cli/security-scan.ts || exit 1

# 7. check-bdd-model 对有效 BDD 样本应退出 0
run_expect "check-bdd-model 有效 BDD 样本退出 0" 0 \
  npx tsx w-model-dev/scripts/cli/check-bdd-model.ts w-model-dev/scripts/samples/bdd/valid-manifest.json --phase=1 || exit 1

# 8. check-bdd-model 对 schema 不合规 BDD 样本应退出 2（输入错误）
run_expect "check-bdd-model schema 不合规 BDD 样本退出 2" 2 \
  npx tsx w-model-dev/scripts/cli/check-bdd-model.ts w-model-dev/scripts/samples/bdd/bad-schema.manifest.json --phase=1 || exit 1

# 9. check:coverage 对有效覆盖样本应退出 0（阶段 1 需求覆盖分析门禁 C1-C10）
run_expect "check:coverage 有效覆盖样本退出 0" 0 \
  npm run check:coverage -- w-model-dev/scripts/samples/coverage/valid-minimal-coverage.json || exit 1

# 10. check:exemption 对有效豁免样本应退出 0（豁免审批门禁 E1-E8，S→R→V→人类四阶段）
run_expect "check:exemption 有效豁免样本退出 0" 0 \
  npm run check:exemption -- w-model-dev/scripts/samples/exemption/valid-full-approval.json || exit 1

# 11. [21.0.0] check-signature-chain 对有效签名链样本应退出 0
run_expect "check-signature-chain 有效签名链样本退出 0" 0 \
  npx tsx w-model-dev/scripts/cli/check-signature-chain.ts w-model-dev/scripts/samples/signature-chain/valid-all-roles.jsonl --phase=1 || exit 1

# 12. vitest 单元测试全量通过（35 test files / 554 tests；WSL 下 testTimeout 已放宽至 30s）
run_expect "vitest 单元测试全通过" 0 npx vitest run || exit 1

# 13. npm audit：依赖漏洞扫描（warn-only，不阻断；离线/网络失败自动跳过）
log "npm audit 依赖漏洞扫描（warn-only）..."
set +e
npm audit --audit-level=high >"$tmp_log" 2>&1
local_audit_code=$?
set -e
if [ "$local_audit_code" -eq 0 ]; then
  ok "npm audit 未发现 high 以上漏洞"
else
  warn "npm audit 返回码 $local_audit_code（发现 high 以上漏洞或网络不可达），warn-only 不阻断 push"
  cat "$tmp_log" >&2
fi

# 14. check-docs-consistency：活体文档一致性门禁（2026-08-10 新增）
run_expect "docs-consistency 活体文档一致" 0 npm run check:docs-consistency || exit 1

log "全部门禁通过，允许推送 ✓"
exit 0
