  "stateMachines": [
    {
      "id": "SM-L1_BlogSystem",
      "level": 1,
      "states": [
        "Ready",
        "Processing",
        "Completed",
        "Failed",
        "Degraded"
      ],
      "initialState": "Ready",
      "terminalStates": [
        "Completed",
        "Failed"
      ],
      "acceptingStates": [
        "Completed"
      ],
      "rejectingStates": [
        "Failed"
      ],
      "transitions": [
        {
          "from": "Ready",
          "event": "processRequest",
          "to": "Processing",
          "guard": "requestAccepted",
          "action": "dispatchToModule"
        },
        {
          "from": "Processing",
          "event": "completeRequest",
          "to": "Completed",
          "guard": "success",
          "action": "deliverResponse"
        },
        {
          "from": "Processing",
          "event": "failRequest",
          "to": "Failed",
          "guard": "externalError",
          "action": "recordFailure"
        },
        {
          "from": "Processing",
          "event": "rejectRequest",
          "to": "Failed",
          "guard": "requestInvalid",
          "action": "returnError"
        },
        {
          "from": "Processing",
          "event": "degrade",
          "to": "Degraded",
          "guard": "overloadDetected",
          "action": "enableFallback"
        },
        {
          "from": "Degraded",
          "event": "recover",
          "to": "Ready",
          "action": "restoreService"
        }
      ],
      "invariants": [
        "Ready => systemAvailable",
        "Processing => requestInFlight",
        "Completed => responseDelivered",
        "Failed => errorRecorded",
        "Degraded => fallbackEnabled"
      ]
    },
    {
      "id": "SM-L2_BlogSystemAuth",
      "level": 2,
      "states": [
        "unauthenticated",
        "authenticated",
        "token_expired"
      ],
      "initialState": "unauthenticated",
      "terminalStates": [
        "token_expired"
      ],
      "acceptingStates": [
        "authenticated"
      ],
      "rejectingStates": [
        "token_expired"
      ],
      "transitions": [
        {
          "from": "unauthenticated",
          "event": "loginSuccess",
          "to": "authenticated",
          "guard": "credentialsValid",
          "action": "issueJwt"
        },
        {
          "from": "token_expired",
          "event": "loginSuccess",
          "to": "authenticated",
          "guard": "credentialsValid",
          "action": "issueJwt"
        },
        {
          "from": "authenticated",
          "event": "tokenExpire",
          "to": "token_expired",
          "action": "invalidateJwt"
        },
        {
          "from": "token_expired",
          "event": "reLogin",
          "to": "authenticated",
          "guard": "credentialsValid",
          "action": "reissueJwt"
        },
        {
          "from": "authenticated",
          "event": "changePassword",
          "to": "unauthenticated",
          "action": "invalidateSession"
        }
      ],
      "invariants": [
        "authenticated => registered",
        "token_expired => tokenIssued"
      ]
    },
    {
      "id": "SM-L2_BlogSystemContent",
      "level": 2,
      "states": [
        "none",
        "draft",
        "published",
        "archived"
      ],
      "initialState": "none",
      "terminalStates": [
        "archived"
      ],
      "acceptingStates": [
        "published"
      ],
      "rejectingStates": [
        "none"
      ],
      "transitions": [
        {
          "from": "none",
          "event": "createDraft",
          "to": "draft",
          "guard": "creatorIsBlogger",
          "action": "persistDraft"
        },
        {
          "from": "draft",
          "event": "publishArticle",
          "to": "published",
          "guard": "creatorIsBlogger",
          "action": "makeVisible"
        },
        {
          "from": "published",
          "event": "editPublishedArticle",
          "to": "draft",
          "action": "reopenDraft"
        },
        {
          "from": "published",
          "event": "archiveArticle",
          "to": "archived",
          "action": "hideFromReaders"
        },
        {
          "from": "archived",
          "event": "unarchiveArticle",
          "to": "draft",
          "action": "restoreDraft"
        },
        {
          "from": "draft",
          "event": "deleteDraft",
          "to": "none",
          "action": "removeArticle"
        }
      ],
      "invariants": [
        "archived => hasPublished",
        "none => ~hasPublished"
      ]
    },
    {
      "id": "SM-L2_BlogSystemInteraction",
      "level": 2,
      "states": [
        "none",
        "active",
        "deleted"
      ],
      "initialState": "none",
      "terminalStates": [
        "deleted"
      ],
      "acceptingStates": [
        "active"
      ],
      "rejectingStates": [
        "deleted"
      ],
      "transitions": [
        {
          "from": "none",
          "event": "postComment",
          "to": "active",
          "guard": "articleVisible",
          "action": "persistComment"
        },
        {
          "from": "active",
          "event": "deleteCommentByAuthor",
          "to": "deleted",
          "guard": "operatorIsAuthor",
          "action": "removeComment"
        }
      ],
      "invariants": [
        "none => articleVisible",
        "deleted => commentDeleterIsAuthor"
      ]
    },
    {
      "id": "SM-L2_BlogSystemDiscovery",
      "level": 2,
      "states": [
        "none",
        "stale",
        "fresh"
      ],
      "initialState": "none",
      "terminalStates": [
        "stale"
      ],
      "acceptingStates": [
        "fresh"
      ],
      "rejectingStates": [
        "stale"
      ],
      "transitions": [
        {
          "from": "none",
          "event": "refreshStats",
          "to": "fresh",
          "action": "loadStats"
        },
        {
          "from": "stale",
          "event": "refreshStats",
          "to": "fresh",
          "action": "reloadStats"
        },
        {
          "from": "fresh",
          "event": "invalidateStats",
          "to": "stale",
          "action": "dropHotList"
        }
      ],
      "invariants": [
        "fresh => hotListState = \"computed\""
      ]
    },
    {
      "id": "SM-L2_BlogSystemAnalytics",
      "level": 2,
      "states": [
        "none",
        "comment",
        "like",
        "follow_publish"
      ],
      "initialState": "none",
      "terminalStates": [
