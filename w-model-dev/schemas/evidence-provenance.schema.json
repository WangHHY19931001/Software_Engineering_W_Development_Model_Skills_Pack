{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://w-model-dev/schemas/evidence-provenance.schema.json",
  "title": "EvidenceSourceProvenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "runId",
    "artifactId",
    "commitSha",
    "verifiedAt",
    "verificationStatus",
    "measurements",
    "sourceFiles",
    "sourceBundleSha256",
    "producerVersion"
  ],
  "properties": {
    "format": { "const": "w-model-evidence-source-provenance" },
    "version": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "artifactId": { "type": "string", "minLength": 1 },
    "commitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "verifiedAt": { "type": "string", "format": "date-time" },
    "verificationStatus": { "const": "passed" },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateLogs", "verifierOutputs", "runLog", "signatureChain"],
      "properties": {
        "gateLogs": { "$ref": "#/definitions/measurement" },
        "verifierOutputs": { "$ref": "#/definitions/measurement" },
        "runLog": { "$ref": "#/definitions/measurement" },
        "signatureChain": { "$ref": "#/definitions/measurement" }
      }
    },
    "sourceFiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/sourceFile" }
    },
    "sourceBundleSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "producerVersion": { "type": "string", "minLength": 1 }
  },
  "definitions": {
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "contentHash"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
        },
        "kind": {
          "type": "string",
          "enum": ["gate-log", "verifier-output", "signature-chain", "run-log"]
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
