{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://w-model-dev/schemas/budget.schema.json",
  "title": "BudgetConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "createdAt", "updatedAt", "perPhase", "project", "onExceed", "killSwitch"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^1\\.0$" },
    "projectId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "perPhase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxTokens", "maxSubagentSpawns", "maxReworkRounds"],
      "properties": {
        "maxTokens": { "type": "integer", "minimum": 0 },
        "maxSubagentSpawns": { "type": "integer", "minimum": 0 },
        "maxReworkRounds": { "type": "integer", "minimum": 0 }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxTokensTotal", "maxTokensPerSession"],
      "properties": {
        "maxTokensTotal": { "type": "integer", "minimum": 0 },
        "maxTokensPerSession": { "type": "integer", "minimum": 0 }
      }
    },
    "onExceed": { "enum": ["pause", "notify", "halt"] },
    "killSwitch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consecutiveReworks", "budgetBurnRate", "tlaReworks"],
      "properties": {
        "consecutiveReworks": { "type": "integer", "minimum": 0 },
        "budgetBurnRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "tlaReworks": { "type": "integer", "minimum": 0 }
      }
    },
    "rootcauseParallelBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxPersonasPerRound", "maxTokensPerPersona", "maxTotalTokensPerRound"],
      "properties": {
        "maxPersonasPerRound": { "type": "integer", "minimum": 1 },
        "maxTokensPerPersona": { "type": "integer", "minimum": 0 },
        "maxTotalTokensPerRound": { "type": "integer", "minimum": 0 }
      }
    },
    "rootcauseRounds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["round", "personas", "totalTokens"],
        "properties": {
          "round": { "type": "integer", "minimum": 1 },
          "personas": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["personaSlice", "tokens"],
              "properties": {
                "personaSlice": { "type": "string", "minLength": 1 },
                "tokens": { "type": "integer", "minimum": 0 }
              }
            }
          },
          "totalTokens": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
