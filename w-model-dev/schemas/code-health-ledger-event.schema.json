{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://w-model-dev/schemas/code-health-ledger-event.schema.json",
  "title": "CodeHealthLedgerEvent",
  "description": "One append-only code-health candidate lifecycle transition with source-bound evidence and signature references.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventKind",
    "candidateId",
    "from",
    "to",
    "actorRole",
    "at",
    "revision",
    "scopeHash",
    "evidenceRefs",
    "signatureRef"
  ],
  "properties": {
    "eventId": { "description": "Never-reused ledger event identifier.", "type": "string", "minLength": 1 },
    "eventKind": {
      "description": "Canonical lifecycle event kind.",
      "enum": [
        "discovery",
        "evidence",
        "review",
        "approval",
        "implementation",
        "verification",
        "gate-failure",
        "root-cause",
        "root-cause-review",
        "root-cause-gate",
        "rework",
        "rollback",
        "archive"
      ]
    },
    "candidateId": {
      "description": "Candidate receiving this transition.",
      "type": "string",
      "pattern": "^CHG-P[1-4]-[0-9]{8}-[0-9]{3,}$"
    },
    "from": {
      "description": "Current candidate state, or null only for an initial event.",
      "type": ["string", "null"],
      "enum": [
        null,
        "discovered",
        "evidenced",
        "under-review",
        "approved",
        "implemented",
        "verified",
        "archived",
        "rejected",
        "deferred",
        "blocked",
        "rolled-back"
      ]
    },
    "to": {
      "description": "Candidate state after this event.",
      "enum": [
        "discovered",
        "evidenced",
        "under-review",
        "approved",
        "implemented",
        "verified",
        "archived",
        "rejected",
        "deferred",
        "blocked",
        "rolled-back"
      ]
    },
    "actorRole": {
      "description": "Role responsible for recording the transition.",
      "enum": ["O", "A", "S", "V", "G", "R", "human"]
    },
    "at": { "description": "UTC transition timestamp.", "type": "string", "format": "date-time" },
    "previousRevision": {
      "description": "Candidate revision before an implementation event; required only for implementation.",
      "$ref": "#/definitions/revision"
    },
    "revision": { "description": "Revision identity attached to the event.", "$ref": "#/definitions/revision" },
    "scopeHash": {
      "description": "SHA-256 digest of the exact candidate scope.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidenceRefs": {
      "description": "Repository-relative evidence references supporting the event.",
      "type": "array",
      "minItems": 1,
      "items": {
        "description": "One evidence reference.",
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?![A-Za-z]:[\\\\])(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      }
    },
    "signatureRef": {
      "description": "Repository-relative signature or provenance reference.",
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\])(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "gateFailureEvidence": {
      "description": "Observed non-zero gate or command failure with explicit candidate and scope binding.",
      "$ref": "#/definitions/gateFailureEvidence"
    },
    "rollbackEvidence": {
      "description": "Observed rollback command and source-bound rollback metadata.",
      "$ref": "#/definitions/rollbackEvidence"
    },
    "archiveEvidence": {
      "description": "Source-bound archive transition summary for the verified-to-archived transition.",
      "$ref": "#/definitions/archiveEvidence"
    }
  },
  "definitions": {
    "relativePath": {
      "description": "Safe repository-relative POSIX path without absolute paths, backslashes, parent traversal, or empty segments.",
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\])(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$"
    },
    "sha256": {
      "description": "Lowercase SHA-256 digest.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision": {
      "description": "Source-bound repository revision identity.",
      "type": "object",
      "additionalProperties": false,
      "required": ["commitSha", "treeSha", "sourceBundleSha256", "analyzedAt"],
      "properties": {
        "commitSha": { "description": "Lowercase Git commit SHA-1.", "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "treeSha": { "description": "Lowercase Git tree SHA-1.", "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "sourceBundleSha256": {
          "description": "SHA-256 of the analyzed source bundle.",
          "$ref": "#/definitions/sha256"
        },
        "analyzedAt": { "description": "UTC analysis timestamp.", "type": "string", "format": "date-time" }
      }
    },
    "commandEvidence": {
      "description": "Command result with explicit observation, real exit code, and controlled raw output hash.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "cwd",
        "environment",
        "platform",
        "toolVersions",
        "startedAt",
        "endedAt",
        "exitCode",
        "observation",
        "rawOutputPath",
        "rawOutputSha256"
      ],
      "properties": {
        "command": {
          "description": "Executable and arguments without shell syntax.",
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!.*[;&|<>\\r\\n]).+$"
        },
        "cwd": { "description": "Repository-relative working directory.", "$ref": "#/definitions/relativePath" },
        "environment": {
          "description": "Audited redacted environment map.",
          "type": "object",
          "additionalProperties": { "description": "Redacted environment value.", "type": "string" }
        },
        "platform": { "description": "Observed platform.", "type": "string", "minLength": 1 },
        "toolVersions": {
          "description": "Observed tool versions.",
          "type": "object",
          "additionalProperties": { "description": "Tool version.", "type": "string" }
        },
        "startedAt": { "description": "UTC command start time.", "type": "string", "format": "date-time" },
        "endedAt": { "description": "UTC command end time.", "type": "string", "format": "date-time" },
        "exitCode": {
          "description": "Real non-negative process exit code, or null when no process result exists.",
          "type": ["integer", "null"],
          "minimum": 0
        },
        "observation": {
          "description": "Command observation state.",
          "enum": ["observed", "not_run", "unavailable", "unverified"]
        },
        "rawOutputPath": {
          "description": "Controlled repository-relative raw output path.",
          "$ref": "#/definitions/relativePath"
        },
        "rawOutputSha256": { "description": "SHA-256 of controlled raw output.", "$ref": "#/definitions/sha256" }
      },
      "allOf": [
        {
          "description": "Observed commands require an exit code.",
          "if": { "properties": { "observation": { "const": "observed" } }, "required": ["observation"] },
          "then": { "properties": { "exitCode": { "type": "integer", "minimum": 0 } } }
        },
        {
          "description": "Non-observed commands cannot claim an exit code.",
          "if": {
            "properties": { "observation": { "enum": ["not_run", "unavailable", "unverified"] } },
            "required": ["observation"]
          },
          "then": { "properties": { "exitCode": { "type": "null" } } }
        }
      ]
    },
    "gateFailureEvidence": {
      "description": "Observed non-zero gate or command failure with explicit candidate, scope, and failure-kind metadata.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "cwd",
        "environment",
        "platform",
        "toolVersions",
        "startedAt",
        "endedAt",
        "exitCode",
        "observation",
        "rawOutputPath",
        "rawOutputSha256",
        "candidateId",
        "scopeHash",
        "failureKind"
      ],
      "properties": {
        "command": {
          "description": "Executable and arguments without shell syntax.",
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!.*[;&|<>\\r\\n]).+$"
        },
        "cwd": { "description": "Repository-relative working directory.", "$ref": "#/definitions/relativePath" },
        "environment": {
          "description": "Audited redacted environment map.",
          "type": "object",
          "additionalProperties": { "description": "Redacted environment value.", "type": "string" }
        },
        "platform": { "description": "Observed platform.", "type": "string", "minLength": 1 },
        "toolVersions": {
          "description": "Observed tool versions.",
          "type": "object",
          "additionalProperties": { "description": "Tool version.", "type": "string" }
        },
        "startedAt": { "description": "UTC command start time.", "type": "string", "format": "date-time" },
        "endedAt": { "description": "UTC command end time.", "type": "string", "format": "date-time" },
        "exitCode": {
          "description": "Real non-negative process exit code, or null when no process result exists.",
          "type": ["integer", "null"],
          "minimum": 0
        },
        "observation": {
          "description": "Command observation state.",
          "enum": ["observed", "not_run", "unavailable", "unverified"]
        },
        "rawOutputPath": {
          "description": "Controlled repository-relative raw output path.",
          "$ref": "#/definitions/relativePath"
        },
        "rawOutputSha256": { "description": "SHA-256 of controlled raw output.", "$ref": "#/definitions/sha256" },
        "candidateId": {
          "description": "Candidate identity bound to the failure.",
          "type": "string",
          "pattern": "^CHG-P[1-4]-[0-9]{8}-[0-9]{3,}$"
        },
        "scopeHash": {
          "description": "Exact candidate scope digest bound to the failure.",
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "failureKind": {
          "description": "Failure category that blocked the candidate.",
          "enum": ["test", "gate", "command"]
        }
      },
      "allOf": [
        {
          "description": "Observed failures require an exit code.",
          "if": { "properties": { "observation": { "const": "observed" } }, "required": ["observation"] },
          "then": { "properties": { "exitCode": { "type": "integer", "minimum": 0 } } }
        },
        {
          "description": "Non-observed failures cannot claim an exit code.",
          "if": {
            "properties": { "observation": { "enum": ["not_run", "unavailable", "unverified"] } },
            "required": ["observation"]
          },
          "then": { "properties": { "exitCode": { "type": "null" } } }
        }
      ]
    },
    "rollbackEvidence": {
      "description": "Complete observed rollback evidence bound to the candidate rollback plan.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "preChangeRevision",
        "patchPath",
        "patchSha256",
        "owner",
        "patchExists",
        "rawOutputExists",
        "sourceRevision"
      ],
      "properties": {
        "command": { "description": "Observed rollback command result.", "$ref": "#/definitions/commandEvidence" },
        "preChangeRevision": {
          "description": "Pre-change commit SHA-1.",
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "patchPath": {
          "description": "Repository-relative rollback patch path.",
          "$ref": "#/definitions/relativePath"
        },
        "patchSha256": { "description": "Rollback patch SHA-256.", "$ref": "#/definitions/sha256" },
        "owner": { "description": "Rollback owner.", "type": "string", "minLength": 1 },
        "patchExists": { "description": "Whether the rollback patch exists.", "const": true },
        "rawOutputExists": { "description": "Whether the controlled rollback output exists.", "const": true },
        "sourceRevision": {
          "description": "Source revision the rollback evidence is bound to.",
          "$ref": "#/definitions/revision"
        }
      }
    },
    "archiveEvidence": {
      "description": "Source-bound archive transition summary: manifest reference and digest, verification level, source revision, and clean redaction.",
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestRef", "manifestSha256", "verificationLevel", "sourceRevision", "redactionStatus"],
      "properties": {
        "manifestRef": {
          "description": "Repository-relative archive manifest reference.",
          "$ref": "#/definitions/relativePath"
        },
        "manifestSha256": { "description": "Archive manifest SHA-256.", "$ref": "#/definitions/sha256" },
        "verificationLevel": {
          "description": "Archive verification level; package-only cannot be upgraded implicitly.",
          "enum": ["package-only", "source-bound"]
        },
        "sourceRevision": {
          "description": "Revision shared by candidate, ledger, and archive transition.",
          "$ref": "#/definitions/revision"
        },
        "redactionStatus": {
          "description": "Archive redaction must be clean before the transition.",
          "const": "clean"
        }
      }
    }
  },
  "allOf": [
    {
      "description": "An archive transition requires its source-bound archive evidence summary.",
      "if": { "properties": { "to": { "const": "archived" } }, "required": ["to"] },
      "then": {
        "type": "object",
        "properties": {
          "archiveEvidence": {
            "description": "Required source-bound archive transition summary.",
            "$ref": "#/definitions/archiveEvidence"
          }
        },
        "required": ["archiveEvidence"]
      }
    },
    {
      "description": "An archive event must target the archived state.",
      "if": { "properties": { "eventKind": { "const": "archive" } }, "required": ["eventKind"] },
      "then": { "properties": { "to": { "const": "archived" } } }
    },
    {
      "description": "A rollback transition requires explicit rollback evidence.",
      "if": { "properties": { "to": { "const": "rolled-back" } }, "required": ["to"] },
      "then": {
        "type": "object",
        "properties": {
          "rollbackEvidence": {
            "description": "Required complete rollback transition evidence.",
            "$ref": "#/definitions/rollbackEvidence"
          }
        },
        "required": ["rollbackEvidence"]
      }
    },
    {
      "description": "A blocked transition requires structured gate failure evidence.",
      "if": { "properties": { "to": { "const": "blocked" } }, "required": ["to"] },
      "then": {
        "type": "object",
        "properties": {
          "gateFailureEvidence": {
            "description": "Required structured gate failure evidence.",
            "$ref": "#/definitions/gateFailureEvidence"
          }
        },
        "required": ["gateFailureEvidence"]
      }
    },
    {
      "description": "A gate-failure event must target blocked and carry structured failure evidence.",
      "if": { "properties": { "eventKind": { "const": "gate-failure" } }, "required": ["eventKind"] },
      "then": {
        "type": "object",
        "properties": {
          "to": { "const": "blocked" },
          "gateFailureEvidence": {
            "description": "Required structured gate failure evidence.",
            "$ref": "#/definitions/gateFailureEvidence"
          }
        },
        "required": ["gateFailureEvidence"]
      }
    },
    {
      "description": "An implementation event must target implemented and carry the previous revision.",
      "if": { "properties": { "eventKind": { "const": "implementation" } }, "required": ["eventKind"] },
      "then": {
        "type": "object",
        "properties": {
          "to": { "const": "implemented" },
          "previousRevision": {
            "description": "Revision the implementation advanced from.",
            "$ref": "#/definitions/revision"
          }
        },
        "required": ["previousRevision"]
      }
    },
    {
      "description": "Only an implementation event may carry a previous revision.",
      "if": {
        "properties": { "previousRevision": { "description": "Candidate revision before implementation." } },
        "required": ["previousRevision"]
      },
      "then": { "properties": { "eventKind": { "const": "implementation" } } }
    }
  ]
}
