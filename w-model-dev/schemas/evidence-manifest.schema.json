{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://w-model-dev/schemas/evidence-manifest.schema.json",
  "title": "EvidenceExportManifest",
  "description": "脱敏运行时审计证据导出清单；files 中每条记录导出相对路径、类别与 SHA-256，并绑定已验证运行 provenance。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "exportedAt", "sourceProject", "provenance", "files"],
  "properties": {
    "schemaVersion": {
      "description": "导出 manifest 格式版本。",
      "type": "string",
      "const": "1.0"
    },
    "exportedAt": {
      "description": "导出时间（ISO-8601 UTC）。",
      "type": "string",
      "format": "date-time"
    },
    "sourceProject": {
      "description": "固定脱敏源项目标识，不得包含原始绝对路径。",
      "const": "<redacted-project>"
    },
    "provenance": {
      "description": "导出包绑定的已验证运行身份、三类源证据测量与导出内容哈希。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "version",
        "runId",
        "commitSha",
        "artifactId",
        "verificationStatus",
        "measurements",
        "contentHash",
        "sourceBundleSha256",
        "producerVersion"
      ],
      "properties": {
        "format": {
          "description": "导出 provenance 格式标识。",
          "const": "w-model-evidence-provenance"
        },
        "version": { "description": "导出 provenance 格式版本。", "const": 1 },
        "runId": {
          "description": "已验证运行的非空标识。",
          "type": "string",
          "minLength": 1
        },
        "commitSha": {
          "description": "验证运行对应的 Git 提交 SHA-1（40 位小写十六进制）。",
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "artifactId": {
          "description": "验证工件的非空标识。",
          "type": "string",
          "minLength": 1
        },
        "verificationStatus": {
          "description": "默认导出只能证明已通过验证的运行。",
          "const": "passed"
        },
        "measurements": {
          "description": "源 gate log、verifier output 与 run log 的数量和规范内容哈希。",
          "type": "object",
          "additionalProperties": false,
          "required": ["gateLogs", "verifierOutputs", "runLog", "signatureChain"],
          "properties": {
            "gateLogs": { "$ref": "#/definitions/measurement" },
            "verifierOutputs": { "$ref": "#/definitions/measurement" },
            "runLog": { "$ref": "#/definitions/measurement" },
            "signatureChain": { "$ref": "#/definitions/measurement" }
          }
        },
        "contentHash": {
          "description": "按路径排序的导出 files 清单规范 SHA-256。",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sourceBundleSha256": {
          "description": "producer 验证的 source 文件 bundle SHA-256。",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "producerVersion": {
          "description": "生成受控 source provenance 的 producer 版本。",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "files": {
      "description": "导出文件清单（不包含 manifest 本身）。",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "kind"],
        "properties": {
          "path": {
            "description": "相对于导出目录的安全 POSIX 路径：禁止反斜杠、绝对路径、空段和 .. 段。重复路径由 verify 语义校验拒绝。",
            "type": "string",
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?!.*(?:^|/)\\.(?:/|$)).+$"
          },
          "sha256": {
            "description": "导出后文件内容的 SHA-256（64 位小写十六进制）。",
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "description": "允许导出的运行时证据类别。",
            "type": "string",
            "enum": ["gate-log", "verifier-output", "signature-chain", "codegraph-query", "run-log"]
          }
        }
      }
    }
  },
  "definitions": {
    "measurement": {
      "description": "一类输入证据的数量及按路径排序的内容哈希。",
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "contentHash"],
      "properties": {
        "count": {
          "description": "纳入本类别测量的文件数。",
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "description": "本类别规范文件清单的 SHA-256。",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
