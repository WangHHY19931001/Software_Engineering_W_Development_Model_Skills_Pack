{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://w-model-dev/schemas/rtm.schema.json",
  "title": "RTMMatrixShape",
  "description": "需求追溯矩阵（RTM）结构 schema，对应 gate-logic.ts RTMMatrixShape",
  "type": "object",
  "additionalProperties": false,
  "required": ["rows", "executionSummary"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "projectId": { "type": "string" },
    "currentPhase": { "type": "integer", "minimum": 1, "maximum": 8 },
    "lastUpdated": { "type": "string" },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirementId", "description", "designDoc", "codeModule", "unitTest", "integrationTest", "systemTest", "acceptanceTest"],
        "properties": {
          "requirementId": { "type": "string", "minLength": 1 },
          "description": { "type": ["string", "null"] },
          "designDoc": { "type": ["string", "null"] },
          "codeModule": { "type": ["string", "null"] },
          "unitTest": { "type": ["string", "null"] },
          "integrationTest": { "type": ["string", "null"] },
          "systemTest": { "type": ["string", "null"] },
          "acceptanceTest": { "type": ["string", "null"] },
          "coverageStatus": { "type": "string" }
        }
      }
    },
    "executionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unitTest", "integrationTest", "systemTest", "acceptanceTest"],
      "properties": {
        "unitTest": { "$ref": "#/$defs/testSummary" },
        "integrationTest": { "$ref": "#/$defs/testSummary" },
        "systemTest": { "$ref": "#/$defs/testSummary" },
        "acceptanceTest": { "$ref": "#/$defs/testSummary" }
      }
    }
  },
  "$defs": {
    "testSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed", "pending", "coverage"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "pending": { "type": "integer", "minimum": 0 },
        "coverage": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    }
  }
}
