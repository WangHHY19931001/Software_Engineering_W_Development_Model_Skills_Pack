{
  "name": "w-model-dev-skill",
  "version": "34.0.0",
  "private": true,
  "description": "W-Model AI Assistant Skill — 编排 + 校验脚本技能包（提示词 + 模板 + 自包含门禁脚本，不内置 LLM 调用）",
  "type": "module",
  "scripts": {
    "self-test": "tsx w-model-dev/scripts/self-test.ts",
    "check:verifier": "tsx w-model-dev/scripts/check-verifier-output.ts",
    "check:gate": "tsx w-model-dev/scripts/check-artifact-gate.ts",
    "check:graph": "tsx w-model-dev/scripts/check-requirement-graph.ts",
    "check:tla": "tsx w-model-dev/scripts/check-tla-model.ts",
    "check:coverage": "tsx w-model-dev/scripts/check-requirement-coverage.ts",
    "check:exemption": "tsx w-model-dev/scripts/check-exemption.ts",
    "setup:hooks": "git config core.hooksPath .githooks",
    "lint:security": "tsx w-model-dev/scripts/security-scan.ts",
    "wm:status": "tsx w-model-dev/scripts/wm-status.ts",
    "wm:metrics": "tsx w-model-dev/scripts/metrics-report.ts",
    "prepush": "PREPUSH_FORCE=1 bash .githooks/pre-push"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^8.57.1",
    "eslint-plugin-security": "^1.7.1",
    "tsx": "^4.19.2",
    "typescript": "^5.3.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
