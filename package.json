{
  "name": "w-model-dev-skill",
  "version": "41.2.0",
  "private": true,
  "description": "W-Model AI Assistant Skill — 编排 + 校验脚本技能包（提示词 + 模板 + 自包含门禁脚本，不内置 LLM 调用）",
  "type": "module",
  "scripts": {
    "//1 校验类": "阶段与资产门禁",
    "check:verifier": "tsx w-model-dev/scripts/cli/check-verifier-output.ts",
    "check:gate": "tsx w-model-dev/scripts/cli/check-artifact-gate.ts",
    "check:graph": "tsx w-model-dev/scripts/cli/check-requirement-graph.ts",
    "check:tla": "tsx w-model-dev/scripts/cli/check-tla-model.ts",
    "check:coverage": "tsx w-model-dev/scripts/cli/check-requirement-coverage.ts",
    "check:exemption": "tsx w-model-dev/scripts/cli/check-exemption.ts",
    "check:docs-consistency": "tsx w-model-dev/scripts/cli/check-docs-consistency.ts",
    "//2 测试类": "单元测试与回归",
    "test": "vitest run --config config/vitest.config.ts",
    "self-test": "tsx w-model-dev/scripts/cli/self-test.ts",
    "coverage": "vitest run --coverage --config config/vitest.config.ts",
    "//3 工具类": "工程工具",
    "postinstall": "node scripts/setup-hooks.cjs",
    "setup:hooks": "git config core.hooksPath .githooks",
    "format": "prettier --config config/prettier.config.cjs --write \"w-model-dev/scripts/**/*.ts\" \"config/**/*.{cjs,ts}\" \"scripts/*.cjs\"",
    "lint:security": "tsx w-model-dev/scripts/cli/security-scan.ts",
    "wm:status": "tsx w-model-dev/scripts/cli/wm-status.ts",
    "wm:metrics": "tsx w-model-dev/scripts/cli/metrics-report.ts",
    "docs:build": "typedoc --tsconfig config/tsconfig.json --out docs/api w-model-dev/scripts/cli w-model-dev/scripts/logic --entryPointStrategy expand --excludeNotDocumented",
    "prepush": "bash .githooks/pre-push --force"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-security": "^1.7.1",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typedoc": "^0.28.20",
    "typescript": "^5.3.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
